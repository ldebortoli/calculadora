<Window x:Class="Cashflow.Windows.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculadora"
        Icon="Assets/AppIcon.ico"
        Width="500"
        MinWidth="400"
        MaxWidth="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeaderText" Foreground="{StaticResource InkBrush}" FontSize="18"
                   FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,12,0,22"
                   Foreground="{StaticResource MutedBrush}" FontSize="13" LineHeight="20" TextWrapping="Wrap" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SecondaryButton" MinWidth="110" Margin="0,0,10,0" Padding="16,10"
                    Style="{StaticResource GhostButton}" IsCancel="True" Click="SecondaryButton_Click" />
            <Button x:Name="AcceptButton" MinWidth="110" Padding="16,10"
                    Style="{StaticResource PrimaryButton}" IsDefault="True" Click="AcceptButton_Click" />
        </StackPanel>
    </Grid>
</Window>

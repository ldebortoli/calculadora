<Window x:Class="Cashflow.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cashflow.Windows.Controls"
        Title="Calculadora"
        Icon="Assets/AppIcon.ico"
        Width="1380"
        Height="820"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackgroundBrush}"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <TabControl>
        <TabItem Header="Cash Flow">
            <Grid>
                <Grid.ColumnDefinitions>
            <ColumnDefinition Width="288" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0E1729">
            <Grid Margin="24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,26">
                        <Image Source="Assets/AppIcon.png" Width="44" Height="44" Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="R U T A" Foreground="#64E4C8" FontSize="11" FontWeight="Bold" />
                            <TextBlock Text="Calculadora" Foreground="White" FontSize="21" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="ESCENARIO" Foreground="#8090AA" FontSize="10" FontWeight="Bold" Margin="0,0,0,7" />
                    <ComboBox x:Name="ScenarioCombo" SelectionChanged="ScenarioCombo_SelectionChanged" DisplayMemberPath="Name" />
                    <TextBlock Text="Nombre" Foreground="#A9B5C8" FontSize="11" Margin="0,12,0,5" />
                    <TextBox x:Name="ScenarioNameBox" />
                    <Button Content="＋ Nuevo escenario" Margin="0,10,0,0" Click="NewScenario_Click" Style="{StaticResource GhostButton}" />
                    <Button Content="＋ Plantilla GrabrFi" Margin="0,8,0,0" Click="NewGrabrFiScenario_Click" Style="{StaticResource GhostButton}" />
                    <Button Content="＋ Plantilla Wallbit Pro" Margin="0,8,0,0" Click="NewWallbitScenario_Click" Style="{StaticResource GhostButton}" />
                    <Button Content="✎ Valores manuales globales" Margin="0,8,0,0" Click="OpenManualRates_Click" Style="{StaticResource GhostButton}" />
                    <Button Content="Eliminar escenario" Margin="0,8,0,0" Click="DeleteScenario_Click" Style="{StaticResource DangerButton}" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,24,0,16">
                    <StackPanel>
                        <Border Height="1" Background="#263248" Margin="0,0,0,22" />
                        <TextBlock Text="SIMULACIÓN" Foreground="#8090AA" FontSize="10" FontWeight="Bold" Margin="0,0,0,10" />
                        <TextBlock Text="Presupuesto total (comisiones incluidas)" Foreground="#C7D0DE" FontSize="12" Margin="0,0,0,5" />
                        <TextBox x:Name="AmountBox" Text="2500" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="La app nunca propone gastar más que este total." Foreground="#8F9CB0" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />

                        <TextBlock Text="Desde" Foreground="#C7D0DE" FontSize="12" Margin="0,16,0,5" />
                        <ComboBox x:Name="MainSourceCombo" DisplayMemberPath="Name" />

                        <TextBlock Text="Hasta" Foreground="#C7D0DE" FontSize="12" Margin="0,16,0,5" />
                        <ComboBox x:Name="MainDestinationCombo" DisplayMemberPath="Name" />

                        <Button Content="Calcular mejor ruta  →" Margin="0,20,0,0" Padding="18,13" Click="Calculate_Click" Style="{StaticResource PrimaryButton}" />
                        <Button x:Name="BinanceUpdateButton" Content="↻ Actualizar mercados internet" Margin="0,8,0,0" Click="UpdateBinanceSpot_Click" Style="{StaticResource GhostButton}" />
                        <TextBlock x:Name="MarketStatusText" Text="Actualiza Binance Spot, dólar blue y dólar oficial." Foreground="#8F9CB0" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Border Background="#202C42" CornerRadius="9" Padding="12" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="CIRCUITOS REALES CARGADOS" Foreground="#FFCE7A" FontSize="10" FontWeight="Bold" />
                                <TextBlock Text="GrabrFi y Wallbit Pro incluyen ACH, stablecoins y retiro directo. Binance usa los libros Spot USDT/ARS y USDC/USDT."
                                           Foreground="#C2CCDA" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="17" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2">
                    <Button Content="Guardar cambios" Click="Save_Click" Style="{StaticResource GhostButton}" />
                    <TextBlock x:Name="SaveStatusText" Text="Todo se guarda en este equipo" Foreground="#7F8DA5" FontSize="10" TextAlignment="Center" Margin="0,9,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="78" />
                <RowDefinition Height="*" />
                <RowDefinition Height="260" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Mapa de transferencias" Foreground="{StaticResource InkBrush}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Arrastrá los nodos. El borde y las líneas naranjas señalan datos que actualizás vos." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="＋ Plataforma" Click="AddNode_Click" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                    <Button Content="＋ Transición" Click="AddRoute_Click" Style="{StaticResource GhostButton}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="24,0,18,18" CornerRadius="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}" ClipToBounds="True">
                <controls:GraphCanvas x:Name="Graph" />
            </Border>

            <Border Grid.Row="2" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,16,18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="RUTAS COMPARADAS" Foreground="#697386" FontSize="10" FontWeight="Bold" />
                            <TextBlock x:Name="ResultSummaryText" Text="Ingresá un monto y calculá para comparar alternativas." Foreground="#243047" FontSize="14" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock x:Name="BestAmountText" Text="—" Foreground="#0D937D" FontSize="22" FontWeight="Bold" TextAlignment="Right" />
                            <TextBlock x:Name="BestPathText" Text="Mejor resultado" Foreground="#697386" FontSize="10" TextAlignment="Right" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ResultsPanel" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Column="2" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,24,24,30">
                    <TextBlock Text="INSPECTOR" Foreground="#8792A5" FontSize="10" FontWeight="Bold" />
                    <TextBlock x:Name="InspectorTitle" Text="Editá tu circuito" Foreground="{StaticResource InkBrush}" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0" />
                    <TextBlock x:Name="InspectorSubtitle" Text="Seleccioná una plataforma o una transición del mapa." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,18" />

                    <Border Background="#2C2317" BorderBrush="#725025" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="● DATOS MANUALES" Foreground="#F2A94A" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="Usá ‘Valores manuales globales’ para actualizar cada proveedor una sola vez. También podés editar una transición: el cambio se replica en todos los escenarios equivalentes."
                                       Foreground="#76572A" FontSize="10" TextWrapping="Wrap" LineHeight="15" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="EmptyEditorPanel" Background="{StaticResource SurfaceSoftBrush}" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Cómo empezar" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="1. Creá o elegí plataformas.&#x0a;2. Unilas con transiciones dirigidas.&#x0a;3. Cargá las comisiones y el cambio.&#x0a;4. Calculá para comparar rutas."
                                       Foreground="#687489" FontSize="12" LineHeight="22" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="NodeEditorPanel" Visibility="Collapsed">
                        <Border x:Name="NodeManualNotice" Background="#2C2317" BorderBrush="#725025" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,0,0,6" Visibility="Collapsed">
                            <TextBlock x:Name="NodeManualNoticeText" Foreground="#E7C184" FontSize="10" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Text="Nombre de plataforma o cuenta" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NodeNameBox" />
                        <TextBlock Text="Moneda (código, por ejemplo USD o ARS)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NodeCurrencyBox" MaxLength="8" />
                        <TextBlock Text="Rol en el circuito" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="NodeKindCombo" />
                        <Button Content="Aplicar cambios" Margin="0,18,0,0" Click="ApplyNode_Click" Style="{StaticResource PrimaryButton}" />
                        <Button Content="Eliminar plataforma" Margin="0,9,0,0" Click="DeleteNode_Click" Style="{StaticResource DangerButton}" />
                    </StackPanel>

                    <StackPanel x:Name="RouteEditorPanel" Visibility="Collapsed">
                        <TextBlock Text="Nombre del tramo" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="RouteLabelBox" />
                        <TextBlock Text="Desde" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="RouteFromCombo" DisplayMemberPath="Name" SelectionChanged="RouteEndpoint_SelectionChanged" />
                        <TextBlock Text="Hasta" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="RouteToCombo" DisplayMemberPath="Name" SelectionChanged="RouteEndpoint_SelectionChanged" />

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Comisión %" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="RoutePercentageBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Comisión fija" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="RouteFixedBox" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Cómo se cobra la comisión" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="RouteFeeApplicationCombo" DisplayMemberPath="Label" />
                        <TextBlock Text="‘Aparte’ reserva la comisión dentro del presupuesto total y calcula cuánto se puede enviar. ‘Descontada’ resta la comisión del monto operado." Foreground="#7B879A" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Fee de trade %" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="RouteTradingFeeBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cargo sobre salida %" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="RouteOutputFeeBox" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Se aplican después del cambio: primero el fee de trade sobre el resultado bruto y luego el cargo de salida." Foreground="#7B879A" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Mínimo del cargo" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="RouteMinimumFeeBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Máximo del cargo" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="RouteMaximumFeeBox" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Topes del cargo porcentual, en la moneda de origen. Dejalos vacíos cuando no correspondan." Foreground="#7B879A" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="RouteMinimumAmountLabel" Text="Monto mínimo" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="RouteMinimumAmountBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="RouteMaximumAmountLabel" Text="Monto máximo" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="RouteMaximumAmountBox" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Rango admitido por esta transición. Dejalo vacío cuando no haya un límite contractual." Foreground="#7B879A" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="RouteInputStepLabel" Text="Paso de orden límite" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="RouteInputStepBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="RouteMinimumOutputLabel" Text="Mínimo recibido" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="RouteMinimumOutputBox" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="El paso redondea hacia abajo y muestra el remanente. El mínimo recibido representa el filtro nocional del mercado." Foreground="#7B879A" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />

                        <TextBlock x:Name="RouteRateLabel" Text="Tipo de cambio" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="RouteRateBox" />
                        <TextBlock x:Name="RouteRateHint" Text="Unidades de moneda destino por cada unidad neta de moneda origen. Se guarda localmente al aplicar cambios." Foreground="#7B879A" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                        <CheckBox x:Name="RouteManualRateCheck" Content="Esta cotización se actualiza manualmente" Foreground="#8A5B16" Margin="0,12,0,0" Checked="RouteManualRateCheck_Changed" Unchecked="RouteManualRateCheck_Changed" />
                        <Border x:Name="RouteManualNotice" Background="#2C2317" BorderBrush="#725025" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,9,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="RouteManualNoticeText" Foreground="#E7C184" FontSize="10" TextWrapping="Wrap" />
                        </Border>
                        <CheckBox x:Name="RouteEnabledCheck" Content="Usar esta transición en los cálculos" Foreground="{StaticResource InkBrush}" Margin="0,16,0,0" />
                        <Button Content="Aplicar cambios" Margin="0,18,0,0" Click="ApplyRoute_Click" Style="{StaticResource PrimaryButton}" />
                        <Button Content="Eliminar transición" Margin="0,9,0,0" Click="DeleteRoute_Click" Style="{StaticResource DangerButton}" />
                    </StackPanel>

                    <Border Background="#102B29" CornerRadius="10" Padding="13" Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Text="CÁLCULO TRANSPARENTE" Foreground="#0D937D" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="El monto inicial es un presupuesto máximo: cargos aparte, fees y redondeos quedan dentro de ese total. Cada resultado muestra cuánto se envía y cuánto llega."
                                       Foreground="#46615B" FontSize="11" TextWrapping="Wrap" LineHeight="17" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            </Border>
            </Grid>
        </TabItem>
        <TabItem Header="Sesión musical">
            <Grid Background="{StaticResource AppBackgroundBrush}">
                <ContentControl x:Name="MusicSessionHost" />
            </Grid>
        </TabItem>
        <TabItem Header="Jubilación">
            <Grid Background="{StaticResource AppBackgroundBrush}">
                <ContentControl x:Name="RetirementHost" />
            </Grid>
        </TabItem>
    </TabControl>
</Window>

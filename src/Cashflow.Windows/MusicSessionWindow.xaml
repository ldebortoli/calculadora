<UserControl x:Class="Cashflow.Windows.MusicSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cashflow.Windows.Controls"
        Background="{StaticResource AppBackgroundBrush}"
        Loaded="Window_Loaded"
        Unloaded="UserControl_Unloaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="370" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0E1729">
            <Grid Margin="25,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="ANEXO" Foreground="#64E4C8" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="Sesión musical" Foreground="White" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock Text="Compará por separado los caminos sin pesos y los que pasan por pesos bancarizados, donde puede ser necesario facturar."
                               Foreground="#AEBACC" FontSize="11" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,18" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,18">
                        <TextBlock Text="OBJETIVO" Foreground="#8090AA" FontSize="10" FontWeight="Bold" />
                        <TextBlock Text="Monto de la sesión (USD)" Foreground="#D2DAE6" FontSize="11" Margin="0,8,0,5" />
                        <TextBox x:Name="TargetUsdBox" Text="400" FontSize="20" FontWeight="SemiBold" />

                        <Border Height="1" Background="#263248" Margin="0,20,0,18" />
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="DATOS DE INTERNET" Foreground="#64E4C8" FontSize="10" FontWeight="Bold" DockPanel.Dock="Left" />
                            <Border Background="#173B3A" CornerRadius="8" Padding="7,3" DockPanel.Dock="Right">
                                <TextBlock Text="AUTOMÁTICO" Foreground="#79E5CF" FontSize="9" FontWeight="Bold" />
                            </Border>
                        </DockPanel>

                        <Border Background="#18253A" CornerRadius="10" Padding="12" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="DÓLAR BLUE" Foreground="#91A0B7" FontSize="9" FontWeight="Bold" />
                                <TextBlock x:Name="BlueQuoteText" Text="Pendiente de actualizar" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock x:Name="BlueTimeText" Text="Fuente: DolarAPI" Foreground="#8E9CB1" FontSize="9" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Background="#18253A" CornerRadius="10" Padding="12" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="DÓLAR OFICIAL" Foreground="#91A0B7" FontSize="9" FontWeight="Bold" />
                                <TextBlock x:Name="OfficialQuoteText" Text="Pendiente de actualizar" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock x:Name="OfficialTimeText" Text="Fuente: DolarAPI" Foreground="#8E9CB1" FontSize="9" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <CheckBox x:Name="AutoRefreshCheck" Content="Actualizar automáticamente mientras la app esté abierta" Foreground="#C9D2DF" FontSize="10" Margin="0,12,0,0" />
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock Text="Cada" Foreground="#AAB6C8" VerticalAlignment="Center" />
                            <TextBox x:Name="RefreshMinutesBox" Width="58" Margin="8,0" Text="10" />
                            <TextBlock Text="minutos" Foreground="#AAB6C8" VerticalAlignment="Center" />
                        </DockPanel>
                        <Button x:Name="RefreshButton" Content="↻ Actualizar internet ahora" Margin="0,10,0,0" Click="Refresh_Click" Style="{StaticResource GhostButton}" />
                        <TextBlock x:Name="RefreshStatusText" Text="Todavía no se consultaron cotizaciones." Foreground="#8F9CB0" FontSize="9" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <Border Height="1" Background="#263248" Margin="0,20,0,18" />
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="DATOS QUE PONÉS VOS" Foreground="#FFCE7A" FontSize="10" FontWeight="Bold" DockPanel.Dock="Left" />
                            <Border Background="#45351E" CornerRadius="8" Padding="7,3" DockPanel.Dock="Right">
                                <TextBlock Text="MANUAL" Foreground="#FFD58C" FontSize="9" FontWeight="Bold" />
                            </Border>
                        </DockPanel>

                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="USD efectivo / USDC" Foreground="#C9D2DF" FontSize="10" Margin="0,7,0,4" />
                                <TextBox x:Name="CashUsdcRateBox" Text="1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="USD efectivo / USDT" Foreground="#C9D2DF" FontSize="10" Margin="0,7,0,4" />
                                <TextBox x:Name="CashUsdtRateBox" Text="1" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Comisión de la persona (%)" Foreground="#C9D2DF" FontSize="10" Margin="0,10,0,4" />
                        <TextBox x:Name="PersonFeeBox" Text="0" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Envío Binance USDC" Foreground="#C9D2DF" FontSize="10" Margin="0,10,0,4" />
                                <TextBox x:Name="BinanceUsdcFeeBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Envío Binance USDT" Foreground="#C9D2DF" FontSize="10" Margin="0,10,0,4" />
                                <TextBox x:Name="BinanceUsdtFeeBox" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Dejalos vacíos si todavía no sabés el costo: esos caminos quedarán marcados como pendientes." Foreground="#8F9CB0" FontSize="9" TextWrapping="Wrap" Margin="0,5,0,0" />
                        <TextBlock Text="Recargo/impuestos compra oficial (%)" Foreground="#C9D2DF" FontSize="10" Margin="0,10,0,4" />
                        <TextBox x:Name="OfficialExtraBox" Text="0" />
                        <CheckBox x:Name="OfficialAvailableCheck" Content="Mi banco confirmó que hoy puedo comprar dólar oficial" Foreground="#FFD58C" FontSize="10" Margin="0,12,0,0" />
                        <TextBlock Text="No lo marques como un rulo repetible: al acceder al oficial asumís una restricción de 90 días para compras de títulos con liquidación en moneda extranjera."
                                   Foreground="#D9B77C" FontSize="9" TextWrapping="Wrap" LineHeight="14" Margin="0,5,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2">
                    <Button Content="Calcular los dos escenarios  →" Click="Calculate_Click" Style="{StaticResource PrimaryButton}" />
                    <TextBlock Text="Todos los valores y cotizaciones quedan guardados localmente." Foreground="#7F8DA5" FontSize="9" TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28,24,28,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="350" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Cómo pagar la próxima sesión" Foreground="{StaticResource InkBrush}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="El grafo separa la alternativa sin ARS de las que pasan por pesos bancarizados. USD, USDC y USDT se comparan como equivalentes de referencia."
                           Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,18,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#102C2A" BorderBrush="#1B6B5D" BorderThickness="1" CornerRadius="12" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SIN PASAR POR PESOS" Foreground="#0D937D" FontSize="10" FontWeight="Bold" />
                            <TextBlock x:Name="BestWithoutMethodText" Text="Actualizá y calculá" Foreground="{StaticResource InkBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock x:Name="BestWithoutPathText" Text="Efectivo vía stablecoin" Foreground="#A5B2C6" FontSize="9" TextWrapping="Wrap" Margin="0,3,12,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock x:Name="BestWithoutCostText" Text="—" Foreground="#0D937D" FontSize="21" FontWeight="Bold" TextAlignment="Right" />
                            <TextBlock Text="débito estimado" Foreground="#8998AF" FontSize="9" TextAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="#14233B" BorderBrush="#2E5387" BorderThickness="1" CornerRadius="12" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PESOS BANCARIZADOS" Foreground="#416FBE" FontSize="10" FontWeight="Bold" />
                            <TextBlock x:Name="BestBankedMethodText" Text="Actualizá y calculá" Foreground="{StaticResource InkBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock x:Name="BestBankedPathText" Text="Puede requerir facturación" Foreground="#A5B2C6" FontSize="9" TextWrapping="Wrap" Margin="0,3,12,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock x:Name="BestBankedCostText" Text="—" Foreground="#416FBE" FontSize="21" FontWeight="Bold" TextAlignment="Right" />
                            <TextBlock Text="débito estimado" Foreground="#8998AF" FontSize="9" TextAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                <Grid>
                    <controls:MusicSessionGraphCanvas x:Name="MusicGraph" />
                    <Border Background="#E61A2334" CornerRadius="8" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,9">
                        <TextBlock Text="● naranja = usa datos manuales   ·   línea intensa = mejor de ese camino" Foreground="#E7C184" FontSize="9" />
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                <StackPanel x:Name="OptionsPanel" />
            </ScrollViewer>

            <Border Grid.Row="4" Background="#2B2114" BorderBrush="#6B4B1E" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="DATOS PENDIENTES O ADVERTENCIAS" Foreground="#9A6513" FontSize="9" FontWeight="Bold" />
                    <TextBlock x:Name="PendingText" Text="Ninguno." Foreground="#E1C38D" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

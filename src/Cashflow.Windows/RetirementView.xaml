<UserControl x:Class="Cashflow.Windows.RetirementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Cashflow.Windows.Controls"
             Background="{StaticResource AppBackgroundBrush}"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0E1729">
            <Grid Margin="24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="PLANIFICACIÓN" Foreground="#64E4C8" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="Jubilación" Foreground="White" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock Text="Proyectá una cartera de acciones y bonos en dólares reales, con aportes mensuales y ajuste por inflación de EE. UU."
                               Foreground="#AEBACC" FontSize="11" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,16" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,18">
                        <TextBlock Text="CAPITAL Y OBJETIVO" Foreground="#8090AA" FontSize="10" FontWeight="Bold" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Acciones iniciales" Foreground="#D2DAE6" FontSize="10" Margin="0,0,0,4" />
                                <TextBox x:Name="InitialStocksBox" Text="0,00" FontSize="15" FontWeight="SemiBold" LostFocus="MoneyBox_LostFocus" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Bonos iniciales" Foreground="#D2DAE6" FontSize="10" Margin="0,0,0,4" />
                                <TextBox x:Name="InitialBondsBox" Text="0,00" FontSize="15" FontWeight="SemiBold" LostFocus="MoneyBox_LostFocus" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Objetivo invertido en dólares de hoy" Foreground="#D2DAE6" FontSize="10" Margin="0,9,0,4" />
                        <TextBox x:Name="TargetInvestedBox" Text="500.000,00" FontSize="17" FontWeight="SemiBold" LostFocus="MoneyBox_LostFocus" />

                        <Border Height="1" Background="#263248" Margin="0,17,0,15" />
                        <TextBlock Text="FLUJO MENSUAL" Foreground="#8090AA" FontSize="10" FontWeight="Bold" />
                        <TextBlock Text="Ingresos mensuales por trabajo (USD)" Foreground="#D2DAE6" FontSize="10" Margin="0,8,0,4" />
                        <StackPanel x:Name="IncomeRowsPanel" />
                        <Button Content="+ Agregar otro ingreso" Click="AddIncome_Click" Style="{StaticResource GhostButton}" Margin="0,7,0,0" />
                        <TextBlock Text="Gastos ordinarios mensuales (USD)" Foreground="#D2DAE6" FontSize="10" Margin="0,9,0,4" />
                        <TextBox x:Name="OrdinaryExpensesBox" Text="0" LostFocus="MoneyBox_LostFocus" />
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Vacaciones por año" Foreground="#D2DAE6" FontSize="10" Margin="0,0,0,4" />
                                <TextBox x:Name="AnnualVacationExpensesBox" Text="0,00" LostFocus="MoneyBox_LostFocus" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Prorrateo mensual" Foreground="#D2DAE6" FontSize="10" Margin="0,0,0,4" />
                                <Border Background="#18253A" BorderBrush="#2A3852" BorderThickness="1" CornerRadius="5" Padding="9,7">
                                    <TextBlock x:Name="VacationMonthlyProrationText" Text="0,00 USD" Foreground="#79E5CF" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Gasto sesión musical mensual (USD)" Foreground="#D2DAE6" FontSize="10" Margin="0,9,0,4" />
                        <TextBox x:Name="MusicSessionExpenseBox" Text="0,00" LostFocus="MoneyBox_LostFocus" />
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="92" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Gasto extra / mes" Foreground="#D2DAE6" FontSize="10" Margin="0,0,0,4" />
                                <TextBox x:Name="ExtraExpensesBox" Text="0" LostFocus="MoneyBox_LostFocus" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Meses" Foreground="#D2DAE6" FontSize="10" Margin="0,0,0,4" />
                                <TextBox x:Name="ExtraMonthsBox" Text="0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Horizonte de autonomía sin ingresos (años)" Foreground="#D2DAE6" FontSize="10" Margin="0,9,0,4" />
                        <TextBox x:Name="RunwayTargetYearsBox" Text="60" />

                        <Border Height="1" Background="#263248" Margin="0,17,0,15" />
                        <TextBlock Text="RESERVAS · PRIORIDAD DE ARRIBA HACIA ABAJO" Foreground="#FFCE7A" FontSize="10" FontWeight="Bold" />
                        <StackPanel x:Name="ReserveRowsPanel" Margin="0,8,0,0" />
                        <Button Content="+ Agregar otra reserva u objetivo" Click="AddReserve_Click" Style="{StaticResource GhostButton}" Margin="0,7,0,0" />
                        <TextBlock Text="0,00 como máximo mensual usa todo el sobrante disponible. Al completar una reserva, el flujo continúa con la siguiente y luego con la inversión."
                                   Foreground="#BBAA8D" FontSize="9" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <Border Height="1" Background="#263248" Margin="0,17,0,15" />
                        <TextBlock Text="CARTERA" Foreground="#8090AA" FontSize="10" FontWeight="Bold" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Objetivo en acciones (USD de hoy)" Foreground="#D2DAE6" FontSize="10" Margin="0,0,0,4" />
                                <TextBox x:Name="StockTargetBox" Text="400.000,00" LostFocus="MoneyBox_LostFocus" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Retorno acciones" Foreground="#D2DAE6" FontSize="10" Margin="0,0,0,4" />
                                <TextBox x:Name="StockReturnBox" Text="10" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Retorno bonos (%)" Foreground="#D2DAE6" FontSize="10" Margin="0,0,0,4" />
                                <TextBox x:Name="BondReturnBox" Text="4" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Retiro anual (%)" Foreground="#D2DAE6" FontSize="10" Margin="0,0,0,4" />
                                <TextBox x:Name="WithdrawalRateBox" Text="3" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Después de completar reservas, cada aporte va a acciones hasta alcanzar su objetivo real. Desde ese momento, los nuevos aportes van a bonos."
                                   Foreground="#8F9CB0" FontSize="9" TextWrapping="Wrap" Margin="0,5,0,0" />

                        <Border Background="#18253A" CornerRadius="10" Padding="12" Margin="0,15,0,0">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="INFLACIÓN EE. UU." Foreground="#64E4C8" FontSize="9" FontWeight="Bold" DockPanel.Dock="Left" />
                                    <Border Background="#173B3A" CornerRadius="8" Padding="7,3" DockPanel.Dock="Right">
                                        <TextBlock Text="BLS" Foreground="#79E5CF" FontSize="9" FontWeight="Bold" />
                                    </Border>
                                </DockPanel>
                                <TextBlock Text="Inflación interanual (%)" Foreground="#C9D2DF" FontSize="10" Margin="0,9,0,4" />
                                <TextBox x:Name="InflationBox" Text="3,36" />
                                <Button x:Name="RefreshInflationButton" Content="↻ Actualizar desde internet" Margin="0,8,0,0" Click="RefreshInflation_Click" Style="{StaticResource GhostButton}" />
                                <TextBlock x:Name="InflationStatusText" Text="Dato inicial BLS: julio de 2026." Foreground="#91A0B7" FontSize="9" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2">
                    <Button Content="Guardar y proyectar  →" Click="Calculate_Click" Style="{StaticResource PrimaryButton}" />
                    <TextBlock x:Name="SaveStatusText" Text="Los cambios también se guardan al cerrar la app." Foreground="#7F8DA5" FontSize="9" TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="26,22,26,28" MinWidth="680">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="340" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Camino hacia tu objetivo" Foreground="{StaticResource InkBrush}" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="La línea principal muestra dólares de poder adquisitivo actual. Hacé clic en un punto para ver sus importes exactos. La rueda solo amplía; el paneo se habilita al ampliar."
                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,17,0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#102C2A" BorderBrush="#1B6B5D" BorderThickness="1" CornerRadius="11" Padding="14">
                        <StackPanel>
                            <TextBlock Text="FECHA ESTIMADA" Foreground="#54D6BE" FontSize="9" FontWeight="Bold" />
                            <TextBlock x:Name="TargetDateText" Text="Completá tus datos" Foreground="{StaticResource InkBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" />
                            <TextBlock x:Name="TargetDateDetailText" Text="Objetivo en dólares reales" Foreground="#93A4BA" FontSize="9" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#14233B" BorderBrush="#2E5387" BorderThickness="1" CornerRadius="11" Padding="14">
                        <StackPanel>
                            <TextBlock Text="RETIRO MENSUAL AL OBJETIVO" Foreground="#79A8FA" FontSize="9" FontWeight="Bold" />
                            <TextBlock x:Name="MonthlyWithdrawalText" Text="—" Foreground="{StaticResource InkBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" />
                            <TextBlock x:Name="NominalWithdrawalText" Text="3% anual dividido 12" Foreground="#93A4BA" FontSize="9" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Background="#2B2114" BorderBrush="#6B4B1E" BorderThickness="1" CornerRadius="11" Padding="14">
                        <StackPanel>
                            <TextBlock Text="SOBRANTE MENSUAL" Foreground="#F1B955" FontSize="9" FontWeight="Bold" />
                            <TextBlock x:Name="SurplusNormalText" Text="—" Foreground="{StaticResource InkBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" />
                            <TextBlock x:Name="SurplusExtraText" Text="Durante gastos extra: —" Foreground="#BBAA8D" FontSize="9" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                    <controls:RetirementProjectionChart x:Name="ProjectionChart" />
                </Border>

                <Grid Grid.Row="3" Margin="0,13,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="13">
                        <StackPanel>
                            <TextBlock Text="ACCIONES AL FINAL · USD REALES" Foreground="#79A8FA" FontSize="9" FontWeight="Bold" />
                            <TextBlock x:Name="StocksResultText" Text="—" Foreground="{StaticResource InkBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" />
                            <TextBlock x:Name="AllocationText" Text="Objetivo de acciones" Foreground="#8F9EB4" FontSize="9" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="13">
                        <StackPanel>
                            <TextBlock Text="BONOS AL FINAL · USD REALES" Foreground="#F1B955" FontSize="9" FontWeight="Bold" />
                            <TextBlock x:Name="BondsResultText" Text="—" Foreground="{StaticResource InkBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" />
                            <TextBlock x:Name="BondAllocationText" Text="Aportes después del tope de acciones" Foreground="#8F9EB4" FontSize="9" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="13">
                        <StackPanel>
                            <TextBlock Text="APORTES Y CRECIMIENTO NOMINAL" Foreground="#54D6BE" FontSize="9" FontWeight="Bold" />
                            <TextBlock x:Name="ContributionsText" Text="Aportes: —" Foreground="{StaticResource InkBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0" />
                            <TextBlock x:Name="GrowthText" Text="Rendimiento: —" Foreground="#8F9EB4" FontSize="9" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="4" Margin="0,23,0,0">
                    <DockPanel LastChildFill="True" Margin="0,0,0,9">
                        <Border DockPanel.Dock="Right" Background="#173B3A" CornerRadius="9" Padding="8,4">
                            <TextBlock x:Name="ReserveGoalSummaryText" Text="OBJETIVOS PENDIENTES" Foreground="#79E5CF" FontSize="9" FontWeight="Bold" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Calendario de reservas" Foreground="{StaticResource InkBrush}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Cada barra respeta el mes de inicio, el máximo mensual y la prioridad definida en el panel."
                                       Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,18,0" />
                        </StackPanel>
                    </DockPanel>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                        <controls:RetirementReserveTimelineChart x:Name="ReserveGoalsChart" Height="230" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="5" Margin="0,23,0,0">
                    <TextBlock Text="Autonomía si desaparecen todos los ingresos" Foreground="{StaticResource InkBrush}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Usa solo el gasto ordinario ajustado por inflación. Consume reservas líquidas, luego el activo de menor retorno y finalmente el de mayor retorno."
                               Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,10" />
                    <Border Background="#291C20" BorderBrush="#6D3540" BorderThickness="1" CornerRadius="11" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="TIEMPO CUBIERTO" Foreground="#F17D8A" FontSize="9" FontWeight="Bold" />
                                <TextBlock x:Name="RunwayDurationText" Text="—" Foreground="{StaticResource InkBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock x:Name="RunwayDetailText" Text="Completá capital, reservas y gasto ordinario." Foreground="#D7B5BB" FontSize="10" TextWrapping="Wrap" />
                                <TextBlock x:Name="RunwayAdjustmentText" Text="Objetivo: 60 años." Foreground="#F1B955" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock x:Name="RunwayAssetsText" Text="—" Foreground="#9D7F86" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Height="310" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                        <controls:RetirementRunwayChart x:Name="RunwayChart" />
                    </Border>
                </StackPanel>

                <Border Grid.Row="6" Background="#151F31" BorderBrush="#2A3852" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,13,0,0">
                    <StackPanel>
                        <TextBlock x:Name="ReserveStatusText" Text="Reservas: completá los objetivos para incluirlas en el plan." Foreground="#E1C38D" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,5" />
                        <TextBlock x:Name="ProjectionStatusText" Text="La proyección aparecerá después de guardar tus supuestos." Foreground="#B9C6D8" FontSize="10" TextWrapping="Wrap" />
                        <TextBlock Text="Estimación orientativa: los retornos y la inflación futura no están garantizados. Un déficit no descuenta capital del camino al objetivo; la simulación de autonomía inferior sí modela el consumo del patrimonio."
                                   Foreground="#7F90A9" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

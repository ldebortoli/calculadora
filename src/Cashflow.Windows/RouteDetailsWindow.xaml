<Window x:Class="Cashflow.Windows.RouteDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle completo · Ruta Cashflow"
        Icon="Assets/AppIcon.ico"
        Width="900"
        Height="700"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6FA"
        ShowInTaskbar="False">
    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="DETALLE COMPLETO DE LA RUTA" Foreground="#0D937D" FontSize="10" FontWeight="Bold" />
            <TextBlock x:Name="PathText" Foreground="#1D2A42" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0" />
            <TextBlock Text="Los importes siguientes no están recortados y muestran cada tramo en el orden de ejecución."
                       Foreground="#697386" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#DDE5EF" BorderThickness="1" CornerRadius="10" Padding="13">
                <StackPanel>
                    <TextBlock Text="PRESUPUESTO INICIAL" Foreground="#7A879B" FontSize="9" FontWeight="Bold" />
                    <TextBlock x:Name="BudgetText" Foreground="#26344C" FontSize="16" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#DDE5EF" BorderThickness="1" CornerRadius="10" Padding="13">
                <StackPanel>
                    <TextBlock Text="DÉBITO REAL" Foreground="#7A879B" FontSize="9" FontWeight="Bold" />
                    <TextBlock x:Name="DebitText" Foreground="#26344C" FontSize="16" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Background="#EAF9F5" BorderBrush="#AFE7DA" BorderThickness="1" CornerRadius="10" Padding="13">
                <StackPanel>
                    <TextBlock Text="LLEGA AL DESTINO" Foreground="#0D937D" FontSize="9" FontWeight="Bold" />
                    <TextBlock x:Name="FinalAmountText" Foreground="#0D937D" FontSize="16" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="StepsPanel" />
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="Consejo: revisá las cotizaciones naranjas antes de ejecutar una transferencia."
                       Foreground="#7A879B" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Content="Cerrar" Width="120" HorizontalAlignment="Right" Click="Close_Click"
                    Foreground="White" Background="#18BFA2" BorderThickness="0" Padding="18,11" FontWeight="SemiBold" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</Window>

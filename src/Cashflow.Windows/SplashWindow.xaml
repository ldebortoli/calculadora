<Window x:Class="Cashflow.Windows.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculadora · Iniciando"
        Width="520"
        Height="310"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
    <Border CornerRadius="28" BorderBrush="#2A3852" BorderThickness="1" Background="#0E1729">
        <Border.Effect>
            <DropShadowEffect Color="#07101F" BlurRadius="32" ShadowDepth="8" Opacity="0.45" />
        </Border.Effect>
        <Grid Margin="42,34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="76" Height="76" CornerRadius="20" Background="#17243D" Margin="0,0,18,0">
                    <Image Source="Assets/AppIcon.png" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="R U T A" Foreground="#64E4C8" FontSize="11" FontWeight="Bold" />
                    <TextBlock Text="Calculadora" Foreground="White" FontSize="31" FontWeight="SemiBold" Margin="0,1,0,0" />
                    <TextBlock Text="Tu dinero, por el camino más conveniente." Foreground="#AAB7CB" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,8">
                <TextBlock Text="Preparando tu mapa de transferencias…" Foreground="#E7EDF6" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="Cargando escenarios y rutas guardadas en este equipo" Foreground="#8594AC" FontSize="11" Margin="0,5,0,0" />
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ProgressBar Height="5" IsIndeterminate="True" Foreground="#18BFA2" Background="#27344B" BorderThickness="0" />
                <TextBlock Grid.Row="1" Text="LOCAL · PRIVADO · SIN CUENTAS" Foreground="#60708A" FontSize="9" FontWeight="Bold" Margin="0,13,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
